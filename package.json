{
  "name": "pixelbob",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "health": "node scripts/health/health.mjs",
    "board": "node studio/board.ts",
    "dev:stills": "pnpm --filter @pixelbob/00-stills dev",
    "dev:sandbox": "pnpm --filter @pixelbob/01-sandbox dev",
    "dev:bob": "pnpm --filter @pixelbob/02-bob dev",
    "dev:concept": "pnpm --filter @pixelbob/concept dev",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "build": "pnpm -r build",
    "build:site": "pnpm build && node scripts/build-site.mjs"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
